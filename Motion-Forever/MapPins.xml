<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<!-- One guild member dot on the world map. Logic is in MapPins.lua. -->
	<Frame name="MotionForeverPinTemplate" mixin="MotionForeverPinMixin" enableMouse="true" virtual="true">
		<Size x="10" y="10"/>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- Dark outline behind the colored dot -->
				<Texture parentKey="Border" file="Interface\CHARACTERFRAME\TempPortraitAlphaMask">
					<Size x="12" y="12"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<!-- White circle, tinted by class color in Lua -->
				<Texture parentKey="Icon" file="Interface\CHARACTERFRAME\TempPortraitAlphaMask" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>
</Ui>
